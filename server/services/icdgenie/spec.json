{
  "openapi": "3.0.0",
  "servers": {
    "url": "/"
  },
  "tags": [
    {
      "name": "Search"
    }
  ],
  "paths": {
    "/api/search": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Search results for keywords, ICD-10, ICD-10-PCS, ICD-11, ICD-O-3, and ICD-O-4 codes",
        "produces": [
          "application/json"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/definitions/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "schema": {
              "$ref": "#/definitions/SearchResponse"
            }
          },
          "400": {
            "description": "Invalid parameters supplied"
          }
        }
      }
    },
    "/api/batch": {
      "post": {
        "tags": [
          "Batch Export"
        ],
        "summary": "Batch export search results for ICD-10, ICD-10-PCS, ICD-11, ICD-O-3, and ICD-O-4 codes",
        "produces": [
          "application/json"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/definitions/BatchExportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "schema": {
              "$ref": "#/definitions/BatchExportResponse"
            }
          },
          "400": {
            "description": "Invalid parameters supplied"
          }
        }
      }
    }
  },
  "definitions": {
    "SearchRequest": {
      "type": "object",
      "properties": {
        "search": {
          "type": "string",
          "description": "A keyword, ICD-10 code, ICD-10-PCS code, ICD-11 code, ICD-O-3 code, or ICD-O-4 code",
          "default": "stomach"
        }
      }
    },
    "SearchResponse": {
      "type": "object",
      "properties": {
        "tabular": {
          "type": "array",
          "description": "ICD-10-CM tabular code results"
        },
        "neoplasm": {
          "type": "array",
          "description": "ICD-10-CM neoplasm table results"
        },
        "drug": {
          "type": "array",
          "description": "ICD-10-CM drug table results"
        },
        "injury": {
          "type": "array",
          "description": "ICD-10-CM injury/external cause results"
        },
        "icdo3": {
          "type": "array",
          "description": "ICD-O-3 morphology code results"
        },
        "icd10pcs": {
          "type": "array",
          "description": "ICD-10-PCS procedure code results"
        },
        "icd11": {
          "type": "array",
          "description": "ICD-11 code results"
        },
        "icdo4": {
          "type": "array",
          "description": "ICD-O-4 morphology code results"
        },
        "showSuggestions": {
          "type": "boolean",
          "description": "Whether to show spell-check suggestions"
        },
        "fuzzyTerms": {
          "type": "array",
          "description": "Suggested search terms from spell-check"
        }
      }
    },
    "BatchExportRequest": {
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "description": "A newline-delimited list of input entries. Each value on a line is deliminated by a tab",
          "default": "1\tT81.535\n2\tNA\n3\tK50.013"
        },
        "inputType": {
          "type": "string",
          "description": "Specifies the type of input data.",
          "enum": [
            "icd10",
            "icd10pcs",
            "icd11",
            "icdo3",
            "icdo4"
          ],
          "default": "icd10"
        },
        "id": {
          "type": "bool",
          "description": "Specifies if input contains a participant id column.",
          "enum": [
            true,
            false
          ],
          "default": true
        },
        "icdo3Morph": {
          "type": "bool",
          "description": "Specifies if input contains a morphology code column (ICD-O-3 inputs only).",
          "enum": [
            true,
            false
          ],
          "default": false
        },
        "icdo3Site": {
          "type": "bool",
          "description": "Specifies if input contains a site code column (ICD-O-3 inputs only).",
          "enum": [
            true,
            false
          ],
          "default": false
        },
        "icdo4Morph": {
          "type": "bool",
          "description": "Specifies if input contains a morphology code column (ICD-O-4 inputs only).",
          "enum": [
            true,
            false
          ],
          "default": false
        },
        "icdo4Site": {
          "type": "bool",
          "description": "Specifies if input contains a site code column (ICD-O-4 inputs only).",
          "enum": [
            true,
            false
          ],
          "default": false
        }
      }
    },
    "BatchExportResponse": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array"
        }
      }
    }
  }
}
